# ===========================================
# Зависимости и пакеты
# ===========================================
/vendor/
/node_modules/

# ===========================================
# Переменные окружения
# ===========================================
.env
.env.local
.env.*.local
# Пример оставляем в репозитории
!.env.example

# ===========================================
# Кэш, логи и временные файлы Smarty/приложения
# ===========================================
/storage/cache/*
/storage/logs/*
!/storage/cache/.gitkeep
!/storage/logs/.gitkeep

# ===========================================
# Загруженные пользователями файлы
# ===========================================
/public/uploads/*
!/public/uploads/.gitkeep

# ===========================================
# Скомпилированные ассеты (если используем SCSS)
# ===========================================
/public/css/*.css
!/public/css/.gitkeep
/public/css/*.map

# ===========================================
# Docker (локальные volume-данные)
# ===========================================
/mysql-data/
/docker/mysql/data/

# ===========================================
# IDE и редакторы
# ===========================================
.idea/
.vscode/
*.swp
*.swo
*~
.project
.buildpath
.settings/

# ===========================================
# Операционная система
# ===========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ===========================================
# Прочее
# ===========================================
*.log
composer.phar
.phpunit.result.cache
.php-history